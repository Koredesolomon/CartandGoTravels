{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "db:dev": "docker compose --env-file .env.development.local -f compose.development.yml up -d --wait --wait-timeout 180",
    "db:dev:stop": "docker compose --env-file .env.development.local -f compose.development.yml stop",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "predev": "node scripts/prepare-pdf-worker.mjs",
    "prebuild": "node scripts/prepare-pdf-worker.mjs",
    "test": "node --test tests/*.test.cjs",
    "evaluate:consular": "node scripts/evaluate-consular.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "mammoth": "^1.13.0",
    "mysql2": "^3.24.5",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
